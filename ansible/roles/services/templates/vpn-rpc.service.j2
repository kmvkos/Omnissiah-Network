[Unit]
Description=Omnissiah restricted VPN RPC service
Requires=omnissiah-vpn-rpc.socket
After=omnissiah-vpn-rpc.socket

[Service]
Type=simple
User=root
Group=root
Environment="OMNISSIAH_NODE_NAME={{ inventory_hostname }}"
# Trusted IPs come from the validated Ansible inventory, not an HTTP plan.
# Protect Omni01 and every Magos management IP during route transactions.
Environment="OMNISSIAH_PROTECTED_MANAGEMENT_IPV4={{ ([hostvars[groups.omnissiah[0]].ansible_host] + (groups.magos | map('extract', hostvars, 'ansible_host') | list)) | join(',') }}"
# Explicit host-level root-helper opt-in; disabled unless set to boolean true in inventory.
{% if omnissiah_vpn_route_transactions_root_enabled | default(false) %}
Environment="OMNISSIAH_ENABLE_ROUTE_TRANSACTIONS=YES"
{% endif %}

# Explicit root-side gate; read-only preview is available without opting in.
{% if omnissiah_policy_apply_root_enabled | default(false) is sameas true %}
Environment="OMNISSIAH_ENABLE_POLICY_APPLY=YES"
{% if omnissiah_policy_restore_boot_enabled | default(false) is sameas true %}
Environment="OMNISSIAH_POLICY_RESTORE_READY=YES"
{% endif %}
{% endif %}
ExecStart=/usr/bin/python3 /usr/local/libexec/omnissiah-vpn-rpc
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/wireguard /var/lib/omnissiah-network

[Install]
WantedBy=multi-user.target
