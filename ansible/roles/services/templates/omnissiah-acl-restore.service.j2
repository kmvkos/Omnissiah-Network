[Unit]
Description=Restore committed Omnissiah ACL before WireGuard starts
After=local-fs.target
Before=wg-quick@wg0.service
ConditionPathExists=/usr/local/libexec/vpn_acl_restore_cli.py

[Service]
Type=oneshot
User=root
Group=root
Environment="OMNISSIAH_NODE_NAME={{ inventory_hostname }}"
Environment="OMNISSIAH_PROTECTED_MANAGEMENT_IPV4={{ ([hostvars[groups.omnissiah[0]].ansible_host] + (groups.magos | map('extract', hostvars, 'ansible_host') | list)) | join(',') }}"
ExecStart=/usr/bin/python3 /usr/local/libexec/vpn_acl_restore_cli.py
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/omnissiah-network
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
