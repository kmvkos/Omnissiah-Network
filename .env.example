# Copy to .env and fill locally. Never commit .env.
# Generate a Fernet key:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
WG_MASTER_KEY=

# Legacy start.sh only; the Ansible/Gunicorn deployment does not require this password.
SUDO_PASSWORD=

# Generate a persistent Flask session secret:
# python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
DEBUG=false

# Optional shared secret for ConfigEncryptor; also configure it on participating agents.
# This is separate from WG_MASTER_KEY. Review provisioning before enabling encryption.
NMC_ENCRYPTION_KEY=
